{
  "name": "univ3-rebalance-bot",
  "version": "0.1.0",
  "description": "Minimal Uniswap V3 liquidity rebalancing bot on Base",
  "type": "module",
  "scripts": {
    "backtest": "MODE=backtest tsx src/index.ts",
    "optimize": "MODE=optimize tsx src/index.ts",
    "scenario": "MODE=scenario tsx src/index.ts",
    "walk-forward": "MODE=walk-forward tsx src/index.ts",
    "compare": "MODE=compare tsx src/index.ts",
    "paper": "MODE=paper tsx src/index.ts",
    "live": "MODE=live tsx src/index.ts",
    "fetch-data": "tsx scripts/fetchPrices.ts",
    "fetch-apr": "tsx scripts/fetchPoolApr.ts",
    "generate-data": "tsx scripts/generateSampleData.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
