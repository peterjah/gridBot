node_modules/
dist/
.env

# Run artifacts. Every backtest and sweep writes a labelled directory of CSVs
# plus a run.json carrying its provenance; they are reproducible from the
# command recorded inside them, so they are not tracked.
results/
results-*/
reports/
*-optimization.csv
*-walk-forward.csv
superseded-*.json

# Bot state: managed position id, fee totals, and the regime price window.
state/

# Regenerated by start.sh on every launch (npm run fetch-data).
data/lp-live-seed-5m.csv

# Note: the price and APR series under data/ ARE tracked, so the pipeline is
# reproducible from a clean checkout. Refresh them with `npm run fetch-data`
# and `npm run fetch-apr`.
