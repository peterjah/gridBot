# Required
# Single endpoint or comma-separated fallbacks:
RPC_URL=https://mainnet.base.org,https://base.publicnode.com
PRIVATE_KEY=

# Pool to monitor (any Uniswap V3 pool on Base)
# Example: WETH/USDC 0.05% pool on Base
POOL_ADDRESS=0xd0b53D9277642d899DF5C87A3966A349A798F224

# Position NFT token id managed by the bot.
# Note: after each rebalance the bot persists the NEW position id to
# STATE_FILE and uses it on restart, overriding this value.
POSITION_ID=1

# Wallet (optional: defaults to the address derived from PRIVATE_KEY)
WALLET_ADDRESS=

# Strategy parameters (in ticks)
RANGE_WIDTH_TICKS=1200
REBALANCE_THRESHOLD_TICKS=600

# Slippage tolerance in basis points (100 = 1%)
SLIPPAGE_BPS=100

# Monitoring loop interval
POLL_INTERVAL_SECONDS=30

# Set to true to never send transactions
DRY_RUN=true

# Local state file tracking the currently managed position NFT id
STATE_FILE=state.json

# Optional overrides (defaults are the official Base deployments)
POSITION_MANAGER_ADDRESS=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1
SWAP_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
