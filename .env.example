# Mode: backtest | paper | live
MODE=backtest

# --- paper / live only ---
# Single endpoint or comma-separated fallbacks
RPC_URL=https://mainnet.base.org,https://base.publicnode.com
# WETH/USDC 0.05% pool on Base
POOL_ADDRESS=0xd0b53D9277642d899DF5C87A3966A349A798F224

# --- live only (never required for backtest/paper) ---
PRIVATE_KEY=
WALLET_ADDRESS=
# Must be "yes" to allow live trading
LIVE_CONFIRM=

# --- capital & grid ---
INITIAL_USDC=10000
INITIAL_ETH=0
GRID_CENTER_PRICE=4000
GRID_SPACING_PERCENT=1
GRID_LEVELS_ABOVE=5
GRID_LEVELS_BELOW=5
ORDER_SIZE_USD=1000

# --- costs modeled per fill ---
SWAP_FEE_BPS=5
SLIPPAGE_BPS=3
ESTIMATED_GAS_USD=0.02

# --- inventory limits ---
MIN_ETH_USD=0
MAX_ETH_USD=1000000000000

# --- grid reset / re-centering ---
# Spacings beyond the outermost level that trigger liquidation + reset (0 = off)
# RESET_BUFFER_SPACINGS is accepted as an alias and takes precedence if set.
GRID_RESET_BUFFER_LEVELS=2
# Minimum seconds in cooldown before the grid may be rebuilt
GRID_REGEN_MIN_SECONDS=21600
# Reset liquidation policy. Defaults reproduce the original full dump.
# Fraction of the ETH inventory sold when a reset fires (1 = sell everything)
RESET_SELL_FRACTION=1
# Carry inventory instead of selling when underwater by more than this % (0 = off).
# Measured to be worse in downtrends: it relabels the reset loss as grid loss
# and raises ETH exposure. Only safe alongside MAX_ETH_USD.
RESET_UNDERWATER_SKIP_PCT=0

# --- LP fee income model ---
# Treats the grid's resting orders as concentrated liquidity earning a
# PRO-RATA share of pool fees while in range. Disabled by default
# (LP_POOL_LIQUIDITY_USD=0) because the bot as implemented SWAPS: it pays
# fees rather than earning them. Enabling this models a different bot.
#   income = refVolume * VENUE_SHARE% * FEE_BPS * myValue/(myValue+POOL_LIQ)
# Requires a price CSV with a third `volume` column (npm run fetch-data).
LP_FEE_BPS=5
LP_VENUE_VOLUME_SHARE_PCT=1
LP_POOL_LIQUIDITY_USD=0

# --- causal regime filter ---
# Pause the grid when the trailing move over REGIME_LOOKBACK_POINTS exceeds
# this percentage (0 = off). Uses only past observations: selecting calm
# periods with hindsight would be lookahead bias.
REGIME_MAX_MOVE_PCT=0
REGIME_LOOKBACK_POINTS=336
# Observations used for the volatility estimate
GRID_VOL_LOOKBACK=24
# Rebuild only when per-observation realized volatility drops below this.
# Also gates BUY orders while active: no accumulation into violent moves.
GRID_MAX_VOL_PER_STEP=0.005
# Circuit breaker: every GRID_BREAKER_RESETS resets within the window doubles
# the required cooldown
GRID_BREAKER_RESETS=3
GRID_BREAKER_WINDOW_SECONDS=2592000

# --- backtest data & output ---
CSV_FILE=data/sample-prices.csv
REPORT_FILE=reports/backtest.html
# Directory for CSV exports (trades.csv, resets.csv, equity.csv, optimization.csv)
RESULTS_DIR=results

# --- parameter optimization (npm run optimize / walk-forward) ---
# Sweep axes, comma-separated. Infeasible combinations are skipped and counted.
OPTIMIZER_SPACINGS=0.25,0.5,0.75,1,1.5,2,3
# Grid half-width in percent; converted to a level count at each spacing
OPTIMIZER_WIDTHS=3,5,10,15,20,30
OPTIMIZER_RESET_BUFFERS=1,2,3,4,5
# Order notional as a percent of initial capital
OPTIMIZER_ORDER_FRACTIONS=1,2,5,10
# Ranking metric: return | risk_adjusted | drawdown | grid_pnl
OPTIMIZER_METRIC=return
# Rows printed in the ranked table
OPTIMIZER_TOP=15
# Share of the data used for parameter selection in train/test mode
OPTIMIZER_TRAIN_FRACTION=0.6
# Walk-forward folds
OPTIMIZER_FOLDS=3
# Center each evaluated grid on the first price of its own period
OPTIMIZER_AUTO_CENTER=true
# Risk axes. Leave unset (or "none") to inherit the values above instead of
# sweeping them. These govern how much inventory builds up before a reset.
# OPTIMIZER_MAX_VOLS=0.005,0.01,0.02
# OPTIMIZER_INVENTORY_CAPS=0,20,40
# OPTIMIZER_COOLDOWN_HOURS=6,24,72

# Archive each run under this name: results/<label>/ + run.json.
# Defaults to the mode name; override per experiment with --label.
# RUN_LABEL=

# --- polling (paper/live) ---
POLL_INTERVAL_SECONDS=30
