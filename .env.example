# Mode: backtest | paper | live
MODE=backtest

# --- paper / live only ---
# Single endpoint or comma-separated fallbacks
# Comma-separated: the client fails over across them in order. Always list at
# least one fallback — a single provider hitting its quota otherwise stops the
# bot completely. Put your paid endpoint first.
RPC_URL=https://mainnet.base.org,https://base.publicnode.com
# WETH/USDC 0.05% pool on Base
POOL_ADDRESS=0xd0b53D9277642d899DF5C87A3966A349A798F224

# --- live only (never required for backtest/paper) ---
PRIVATE_KEY=
WALLET_ADDRESS=

# --- BROADCASTING: both of these are required, and both default to safe ------
# DRY_RUN=true    plan and log every step, broadcast nothing   (default)
# DRY_RUN=false   broadcast real transactions -- also needs LIVE_CONFIRM=yes
#
# Two switches rather than one because there is no confirmation prompt in a
# container or under --yes: setting both is the deliberate act of authorising
# real transactions. Setting only one is refused, on purpose.
DRY_RUN=true
LIVE_CONFIRM=

# --- capital & grid ---
INITIAL_USDC=10000
INITIAL_ETH=0
GRID_CENTER_PRICE=4000
GRID_SPACING_PERCENT=1
GRID_LEVELS_ABOVE=5
GRID_LEVELS_BELOW=5
ORDER_SIZE_USD=1000

# --- gas model ---
# Flat model (default): every fill costs ESTIMATED_GAS_USD, nothing is batched.
# Structured model: fills produced by one observation go in ONE multicall tx,
# so the fixed cost is paid once per transaction rather than once per fill.
#   gas = GAS_TX_OVERHEAD_USD + fills*GAS_PER_FILL_USD + GAS_LENDING_LEG_USD
GAS_TX_OVERHEAD_USD=0
# Defaults to ESTIMATED_GAS_USD when unset
# GAS_PER_FILL_USD=0.02
# Extra cost when the tx also moves money-market funds so lent assets are
# available to trade. Charged once per transaction, not per fill.
GAS_LENDING_LEG_USD=0
GAS_LENDING_LEGS=false

# --- costs modeled per fill ---
SWAP_FEE_BPS=5
SLIPPAGE_BPS=3
ESTIMATED_GAS_USD=0.02

# --- inventory limits ---
MIN_ETH_USD=0
MAX_ETH_USD=1000000000000

# --- grid reset / re-centering ---
# Spacings beyond the outermost level that trigger liquidation + reset (0 = off)
# RESET_BUFFER_SPACINGS is accepted as an alias and takes precedence if set.
GRID_RESET_BUFFER_LEVELS=2
# Minimum seconds in cooldown before the grid may be rebuilt
GRID_REGEN_MIN_SECONDS=21600
# Reset liquidation policy. Defaults reproduce the original full dump.
# Fraction of the ETH inventory sold when a reset fires (1 = sell everything)
RESET_SELL_FRACTION=1
# Carry inventory instead of selling when underwater by more than this % (0 = off).
# Measured to be worse in downtrends: it relabels the reset loss as grid loss
# and raises ETH exposure. Only safe alongside MAX_ETH_USD.
RESET_UNDERWATER_SKIP_PCT=0

# --- LP fee income model ---
# Treats the grid's resting orders as concentrated liquidity earning a
# PRO-RATA share of pool fees while in range. Disabled by default
# (LP_POOL_LIQUIDITY_USD=0) because the bot as implemented SWAPS: it pays
# fees rather than earning them. Enabling this models a different bot.
#   income = refVolume * VENUE_SHARE% * FEE_BPS * myValue/(myValue+POOL_LIQ)
# Requires a price CSV with a third `volume` column (npm run fetch-data).
LP_FEE_BPS=5
LP_VENUE_VOLUME_SHARE_PCT=1
LP_POOL_LIQUIDITY_USD=0

# --- causal regime filter ---
# Pause the grid when the trailing move over REGIME_LOOKBACK_POINTS exceeds
# this percentage (0 = off). Uses only past observations: selecting calm
# periods with hindsight would be lookahead bias.
REGIME_MAX_MOVE_PCT=0
REGIME_LOOKBACK_POINTS=336
# Observations used for the volatility estimate
GRID_VOL_LOOKBACK=24
# Rebuild only when per-observation realized volatility drops below this.
# Also gates BUY orders while active: no accumulation into violent moves.
GRID_MAX_VOL_PER_STEP=0.005
# Skip the post-reset cooldown when the reset had NO inventory to sell.
# Such a reset realized nothing and de-risked nothing, so waiting afterwards
# protects nothing and only costs time in the market. Measured on real ETH:
# out-of-market time 6.9% -> 2.1%, median +1.9 pts return and +2.3 risk-adjusted
# across six configurations. Default off (preserves the original behaviour).
RESET_SKIP_COOLDOWN_WHEN_FLAT=false

# Circuit breaker: every GRID_BREAKER_RESETS resets within the window doubles
# the required cooldown
GRID_BREAKER_RESETS=3
GRID_BREAKER_WINDOW_SECONDS=2592000

# --- smart-reset guards (defaults preserve legacy behavior) ---
# Price must close outside the band this many extra consecutive observations
# before a reset triggers (whipsaw filter). 0 = immediate.
RESET_CONFIRM_OBSERVATIONS=0
# Postpone reset liquidation while realized vol > GRID_MAX_VOL_PER_STEP
RESET_VOL_POSTPONE=false
# Backstop: force FULL liquidation when portfolio drawdown from peak hits this
# Measured on real ETH: both guards below are net-negative on this data.
# Confirmation costs a median 0.3 pts of return and 0.65 of risk-adjusted
# return (helps in only 113/312 paired configs); vol-postpone costs 1.33 pts
# and 1.26 (helps in 82/312). Left at 0/false; turn on only with evidence
# from your own data.
# Backstop on TOTAL PORTFOLIO drawdown from peak. Note this cannot bind for
# a fee-earning grid: the portfolio is mostly cash plus accumulated fees, so a
# position 35% underwater moves it only a couple of percent. Kept for the
# catastrophic case; use the inventory measure below for real protection.
RESET_HARD_DRAWDOWN_PCT=25
# Backstop on the AT-RISK slice: force a full liquidation when open inventory
# is underwater by more than this % of its cost basis (0 = off). This is the
# one that can actually fire. On a wide grid (±30%, buffer 5) a 15% setting
# improved return +71.6% -> +86.8% and max drawdown -2.65% -> -0.86%.
# On tight grids the band exit already caps the loss, so it never binds.
RESET_HARD_INVENTORY_LOSS_PCT=0

# How optimize picks the winner:
#   walk-forward (default) — most fold-wins across expanding-window folds
#   full                   — best on the entire dataset (overfits easily)
OPTIMIZER_SELECTION=walk-forward
OPTIMIZER_FOLDS=3
OPTIMIZER_TRAIN_FRACTION=0.6

# --- backtest data & output ---
CSV_FILE=data/sample-prices.csv
REPORT_FILE=reports/backtest.html
# Directory for CSV exports (trades.csv, resets.csv, equity.csv, optimization.csv)
RESULTS_DIR=results

# --- parameter optimization (npm run optimize / walk-forward) ---
# Sweep axes, comma-separated. Infeasible combinations are skipped and counted.
OPTIMIZER_SPACINGS=0.25,0.5,0.75,1,1.5,2,3
# Grid half-width in percent; converted to a level count at each spacing
OPTIMIZER_WIDTHS=3,5,10,15,20,30
OPTIMIZER_RESET_BUFFERS=1,2,3,4,5
# Order notional as a percent of initial capital
OPTIMIZER_ORDER_FRACTIONS=1,2,5,10
# Ranking metric: return | risk_adjusted | drawdown | grid_pnl
OPTIMIZER_METRIC=return
# Rows printed in the ranked table
OPTIMIZER_TOP=15
# Share of the data used for parameter selection in train/test mode
OPTIMIZER_TRAIN_FRACTION=0.6
# Walk-forward folds
OPTIMIZER_FOLDS=3
# Center each evaluated grid on the first price of its own period
OPTIMIZER_AUTO_CENTER=true
# Risk axes. Leave unset (or "none") to inherit the values above instead of
# sweeping them. These govern how much inventory builds up before a reset.
# OPTIMIZER_MAX_VOLS=0.005,0.01,0.02
# OPTIMIZER_INVENTORY_CAPS=0,20,40
# OPTIMIZER_COOLDOWN_HOURS=6,24,72

# Archive each run under this name: results/<label>/ + run.json.
# Defaults to the mode name; override per experiment with --label.
# RUN_LABEL=

# --- Aave lending of idle liquidity (live mode; defaults = official Base deployments) ---
# Supply ALL idle USDC/WETH to the Aave V3 Base pool (yield on everything).
# Before each grid fill, funds are auto-withdrawn from Aave if the wallet is
# short, so trading works with zero liquid balance (one extra tx per fill).
# Set a buffer > 0 to keep some funds liquid and avoid that extra tx.
ENABLE_AAVE=false
AAVE_POOL=0xA238Dd80C259a72e81d7e4664a9801593F98d1c5
A_USDC=0x4e65fE4DbA92790696d040ac24Aa414708F5c0AB
A_WETH=0xD4a0e0b9149BCee3C920d2E00b5dE09138fd8bb7
# Liquid USDC kept out of Aave (USD). 0 = lend everything.
LEND_BUFFER_USDC=0
# Liquid ETH kept out of Aave. 0 = lend everything.
LEND_BUFFER_ETH=0
# Skip lending actions below this size (USD) to avoid gas churn
LEND_MIN_ACTION_USD=100
# How often to sweep idle balances into/out of Aave
LEND_INTERVAL_SECONDS=3600

# --- paper soak ---
# Log target for the soak; run:  npm run paper 2>&1 | tee -a paper.log
# Then summarize with:           npm run soak-report -- --log paper.log
SOAK_LOG_FILE=paper.log
SOAK_DAYS=0

# --- polling (paper/live) ---
POLL_INTERVAL_SECONDS=30

# --- Live Uniswap V3 LP re-centring (MODE=lp-live) --------------------------
# The on-chain counterpart of the passive-LP backtest: one concentrated
# position held around spot, re-centred when price drifts past the trigger.
# These are the same numbers reported by `npm run lp` in lp-optimization.csv.
LP_RANGE_PCT=5
LP_RECENTER_BUFFER_PCT=50
LP_RECENTER_MIN_HOURS=24
# Explicit tick overrides (leave unset to derive from the percentages above)
# LP_WIDTH_TICKS=
# LP_THRESHOLD_TICKS=
LP_SLIPPAGE_BPS=50
# Position NFT to manage. 0 mints a fresh one from the wallet balances.
POSITION_ID=0
STATE_FILE=state/position.json
# Broadcasting is controlled by DRY_RUN / LIVE_CONFIRM near the top of this
# file; both must be set together.
# Base mainnet defaults; override only for another chain.
# POSITION_MANAGER_ADDRESS=0x03a520b32C04BF3bEEf7BEb72E919cf822Ed34f1
# SWAP_ROUTER_ADDRESS=0x2626664c2603336E57B271c5C0b26F421741e481
# QUOTER_ADDRESS=0x3d4e44Eb1374240CE5F1B871ab261CD16335B76a
# --- Aave lending of idle capital (lp-live) ---------------------------------
# While the regime filter stands aside, idle USDC and WETH are supplied to
# Aave V3 and withdrawn in full before the bot deploys again, so lent assets
# are always available for LP. Amounts below LEND_MIN_ACTION_USD are left
# alone rather than spending gas on dust.
ENABLE_AAVE=false
LEND_MIN_ACTION_USD=100

# The regime filter above (REGIME_MAX_MOVE_PCT / REGIME_LOOKBACK_POINTS) also
# governs lp / lp-live: the position is closed to cash while the trailing move
# exceeds the threshold. It cuts tail risk substantially and parks 55-69% of
# the time at the settings that help. NOTE the lookback is in OBSERVATIONS, so
# it depends on the data resolution: 336 = 14 days hourly, 2016 = 7 days on
# 5-minute data.
# Live LP regime filter. The lookback is in HOURS here (the backtest counts
# observations): 2016 observations of 5-minute data = 168 hours.
LP_REGIME_LOOKBACK_HOURS=168
LP_REGIME_SAMPLE_MINUTES=60
# Price CSV used to pre-fill the regime window at startup. Deliberately NOT
# CSV_FILE, which defaults to generated sample data — seeding a live risk
# filter from synthetic prices gives a confident, meaningless verdict.
# start.sh sets this for you.
# LP_SEED_FILE=data/lp-live-seed-5m.csv

# --- short hedge (off) ------------------------------------------------------
# Borrows WETH against collateral and sells it, so the parked book is flat
# against ETH rather than merely uninvested.
#
# Off by default, and not merely for caution: while parked the ETH is loose
# tokens, so selling them reaches the same flat book in one step. Borrowing
# the same asset back to cancel a position you already hold adds three
# transactions, a permanent borrow-minus-supply rate spread and liquidation
# risk, for no extra hedging. A borrow is the right tool only for exposure you
# cannot sell — the LP position's own delta while deployed — which this does
# not cover.
HEDGE_ENABLED=false
HEDGE_RATIO_PCT=100
HEDGE_MAX_LTV_PCT=40
# Unwind when Aave's health factor reaches this. Liquidation is at 1.0; the
# default leaves room for an oracle move plus the unwind swap.
HEDGE_MIN_HEALTH_FACTOR=1.6
